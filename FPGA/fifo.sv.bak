//=============================================================================
// fifo.sv
// Cola de comandos entre el esclavo Avalon-MM y el decodificador (IF-06)
//
// Es una cola sincrona convencional salvo por una decision que el diseno fija
// de forma explicita: la escritura nunca bloquea. El camino de ida es
// diferido, el maestro del puente ligero no espera respuesta, y detener la
// escritura trasladaria la contrapresion hasta el driver de Linux. En su
// lugar, una escritura sobre la cola llena se descarta y el descarte se hace
// observable: el pulso de 'drop' y el contador 'drop_count' alimentan el
// codigo EC-08, el registro de estado y el LED de error. Se pierden solo los
// paquetes que no cupieron; los almacenados se ejecutan normalmente.
//
// La lectura tiene un ciclo de latencia y la acompana 'dout_valid'. Es
// deliberado: una cola de lectura combinacional obligaria a implementar la
// memoria con registros o MLAB, y a la profundidad del sistema completo
// (256 comandos de 168 bits) eso desbordaria el presupuesto de logica. Con
// la salida registrada la sintesis la ubica en bloques M10K, que es donde la
// perspectiva de recursos la tiene reservada.
//=============================================================================
module fifo #(
  parameter int DATA_W = 168,
  parameter int DEPTH  = 16            // debe ser potencia de dos
)(
  input  logic                clk,
  input  logic                rst_n,
  input  logic                flush,         // vaciado, usado por MOE-01

  // escritura, no bloqueante
  input  logic                wr_en,
  input  logic [DATA_W-1:0]   din,

  // lectura, con un ciclo de latencia
  input  logic                rd_en,
  output logic [DATA_W-1:0]   dout,
  output logic                dout_valid,

  // estado
  output logic                full,
  output logic                empty,
  output logic [$clog2(DEPTH):0] level,       // 0 a DEPTH, de ahi el bit extra
  output logic                drop,           // pulso: una escritura perdida
  output logic [15:0]         drop_count
);

  localparam int PW = $clog2(DEPTH);          // bits de puntero

  // El nivel necesita un bit mas que el puntero para poder valer DEPTH.
  localparam logic [PW:0] NIVEL_MAX = (PW + 1)'(DEPTH);

  logic [DATA_W-1:0] mem [0:DEPTH-1];
  logic [PW-1:0]     wr_ptr, rd_ptr;

  // Aceptar y extraer son las dos condiciones de las que depende todo lo
  // demas; nombrarlas evita repetir la misma conjuncion en cada bloque.
  logic acepta, extrae;
  assign acepta = wr_en && !full;
  assign extrae = rd_en && !empty;

  assign full  = (level == NIVEL_MAX);
  assign empty = (level == '0);
  assign drop  = wr_en && full;

  //------------------------------------------------------------- memoria
  always_ff @(posedge clk) begin
    if (acepta) mem[wr_ptr] <= din;
  end

  //------------------------------------------------------------ punteros
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      wr_ptr <= '0;
      rd_ptr <= '0;
      level  <= '0;
    end else if (flush) begin
      wr_ptr <= '0;
      rd_ptr <= '0;
      level  <= '0;
    end else begin
      if (acepta) wr_ptr <= wr_ptr + 1'b1;
      if (extrae) rd_ptr <= rd_ptr + 1'b1;

      // El nivel solo cambia cuando una de las dos ocurre sin la otra.
      case ({acepta, extrae})
        2'b10:   level <= level + 1'b1;
        2'b01:   level <= level - 1'b1;
        default: level <= level;
      endcase
    end
  end

  //-------------------------------------------------- salida registrada
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      dout       <= '0;
      dout_valid <= 1'b0;
    end else if (flush) begin
      dout_valid <= 1'b0;
    end else begin
      dout_valid <= extrae;
      if (extrae) dout <= mem[rd_ptr];
    end
  end

  //--------------------------------------------- contador de descartes
  // Satura en lugar de dar la vuelta: un contador que vuelve a cero puede
  // hacer creer que no hubo perdidas.
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n)                       drop_count <= '0;
    else if (flush)                   drop_count <= '0;
    else if (drop && !(&drop_count)) drop_count <= drop_count + 16'd1;
  end

`ifndef SYNTHESIS
  // La profundidad tiene que ser potencia de dos: los punteros dan la vuelta
  // solos y no hay comparacion contra DEPTH en el camino critico.
  initial begin
    if ((DEPTH < 2) || ((DEPTH & (DEPTH - 1)) != 0)) begin
      $error("fifo: DEPTH (%0d) debe ser una potencia de dos mayor o igual a 2",
             DEPTH);
    end
  end
`endif

endmodule
