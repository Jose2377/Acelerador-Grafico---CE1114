//=============================================================================
// decoder_fsm.sv
// Decodificador de comandos y maquina de estados del sistema (MOE-01 a MOE-06)
//
// Extrae comandos de la cola respetando el principio FIFO, los valida, los
// traduce a la operacion que entiende el rasterizador y espera a que termine
// antes de tomar el siguiente. Implementa los seis modos de la perspectiva de
// dinamica de estados:
//
//   MOE-01 Inicio          vacia la cola y pone a cero los contadores
//   MOE-02 Espera          la cola esta vacia
//   MOE-03 Procesamiento   lectura, decodificacion y ejecucion
//   MOE-04 Swap Buffer     intercambio, efectivo solo en el flanco de VSYNC
//   MOE-05 Informe         cierra la ventana de medicion y publica
//   MOE-06 Error           registra y continua
//
// MOE-06 no es absorbente: el sistema nunca se detiene por un error. Se pasa
// por el modo el tiempo justo para senalizarlo y se vuelve a la espera.
//
// Sobre el desbordamiento de la cola: la tabla de transiciones lo describe
// como "cualquiera -> MOE-06". Interrumpir el comando en curso para ir a
// MOE-06 lo perderia, y el diseno es explicito en que los paquetes
// almacenados se ejecutan normalmente y solo se descartan los que no
// cupieron. Por eso el error se registra en el instante en que ocurre, sea
// cual sea el estado, y la visita a MOE-06 queda pendiente hasta que el
// comando en curso termina. No se pierde ni se retrasa el registro del
// error; lo unico que espera es la senalizacion del modo.
//=============================================================================
module decoder_fsm #(
  parameter int SCREEN_W = 64,
  parameter int SCREEN_H = 48
)(
  input  logic        clk,
  input  logic        rst_n,
  input  logic        enable,          // bit enable del registro CONTROL
  input  logic        soft_reset,      // bit reset_soft del registro CONTROL

  //------------------------------------------------- lado de la cola (IF-06)
  input  logic        fifo_empty,
  input  logic [Acelerador_pkg::CMD_BITS-1:0] fifo_dout,
  input  logic        fifo_dout_valid,
  input  logic        fifo_drop,       // pulso de descarte por desbordamiento
  output logic        fifo_rd,

  //------------------------------------------- lado del rasterizador (IF-07)
  output logic        ras_start,
  output logic [3:0]  ras_op,
  output logic signed [15:0] ras_x0, ras_y0, ras_x1, ras_y1, ras_x2, ras_y2,
  output logic [9:0]  ras_radius,
  output logic [7:0]  ras_r, ras_g, ras_b,
  input  logic        ras_busy,
  input  logic        ras_done,

  //------------------------------------------------------- video y medicion
  input  logic        vsync,           // del controlador VGA
  output logic        buffer_sel,      // 0 = buffer A delante, 1 = buffer B
  output logic        perf_latch,      // pulso: congelar la ventana (INF)
  output logic        perf_clear,      // pulso: reiniciar la ventana

  //------------------------------------------------------------- estado
  output logic [2:0]  modo,            // MOE-01 a MOE-06, para STATUS y LED
  output logic        busy,
  output logic [3:0]  err_last,
  output logic [15:0] err_count,
  output logic [31:0] cmd_count,       // comandos aceptados y completados
  output logic        cmd_tick,        // pulso: un comando mas completado
  output logic [15:0] seq_last         // SEQ_ID del ultimo comando aceptado
);

  localparam int INIT_CICLOS = 4;      // duracion de MOE-01

  Acelerador_pkg::sys_state_e st;

  logic [2:0] init_cnt;
  logic       err_pend;                // hay un error que MOE-06 debe senalar
  logic       vsync_q;                 // para detectar el flanco

  // El comando que acaba de salir de la cola, ya como estructura. La cola
  // transporta bits y no necesita conocer el formato del paquete; el cambio
  // de tipo ocurre aqui, en el unico modulo que si lo conoce.
  Acelerador_pkg::cmd_t cmd_in;
  assign cmd_in = fifo_dout;

  //------------------------------------------------------------- validacion
  // El recorte por pixel hace que ninguna coordenada sea invalida: una
  // figura puede empezar fuera de la pantalla y entrar en ella, y el diseno
  // es explicito en que eso no convierte el comando en erroneo. Lo unico que
  // el hardware puede declarar inconsistente por si mismo es un radio nulo
  // en los comandos de circulo, que no describe ninguna circunferencia.
  function automatic logic parametros_validos(input Acelerador_pkg::cmd_t c);
    case (c.opcode)
      Acelerador_pkg::OPC_CIRC,
      Acelerador_pkg::OPC_CIRC_FILL: parametros_validos = (c.param != 16'd0);
      default:                       parametros_validos = 1'b1;
    endcase
  endfunction

  //--------------------------------------------------- deteccion de errores
  // Se calcula de forma combinacional para que el registro del error no
  // dependa de en que rama de la maquina se este: asi el desbordamiento y el
  // comando invalido se contabilizan por el mismo camino, y si coinciden en
  // el mismo ciclo se cuentan los dos.
  logic       cmd_listo;
  logic       err_opcode, err_param, err_cmd;
  logic [1:0] err_inc;
  logic [3:0] err_cod;

  assign cmd_listo  = (st == Acelerador_pkg::MOE_PROC) && fifo_dout_valid;
  assign err_opcode = cmd_listo && !Acelerador_pkg::opcode_valido(cmd_in.opcode);
  assign err_param  = cmd_listo && !err_opcode && !parametros_validos(cmd_in);
  assign err_cmd    = err_opcode || err_param;
  assign err_inc    = {1'b0, err_cmd} + {1'b0, fifo_drop};

  // Para err_last manda el error del comando, porque es el que lleva al
  // sistema a MOE-06 en este instante. El desbordamiento sigue siendo
  // visible por su propio contador y por el bit de overflow del estado.
  always_comb begin
    if      (err_opcode) err_cod = Acelerador_pkg::EC_06_OPCODE;
    else if (err_param)  err_cod = Acelerador_pkg::EC_07_PARAM;
    else                 err_cod = Acelerador_pkg::EC_08_OVERFLOW;
  end

  //----------------------------------------------------------- modo visible
  // MOE_WAIT es un subestado interno de MOE-03 y hacia afuera se presenta
  // como procesamiento: el mapa de registros solo conoce seis modos.
  always_comb begin
    if (st == Acelerador_pkg::MOE_WAIT) modo = Acelerador_pkg::MOE_PROC;
    else                                modo = st;
  end

  assign busy = (st != Acelerador_pkg::MOE_IDLE);

  //----------------------------------------- registro de errores y contador
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      err_last  <= Acelerador_pkg::EC_NONE;
      err_count <= '0;
    end else if (st == Acelerador_pkg::MOE_INIT) begin
      err_last  <= Acelerador_pkg::EC_NONE;
      err_count <= '0;
    end else if (err_inc != 2'd0) begin
      err_last  <= err_cod;
      // Satura en lugar de dar la vuelta: un contador que vuelve a cero
      // puede hacer creer que no hubo errores.
      if (err_count < (16'hFFFF - 16'(err_inc))) err_count <= err_count + 16'(err_inc);
      else                                        err_count <= 16'hFFFF;
    end
  end

  //-------------------------------------------------------- maquina de estados
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      st         <= Acelerador_pkg::MOE_INIT;
      init_cnt   <= '0;
      fifo_rd    <= 1'b0;
      ras_start  <= 1'b0;
      ras_op     <= '0;
      ras_x0 <= '0; ras_y0 <= '0; ras_x1 <= '0; ras_y1 <= '0;
      ras_x2 <= '0; ras_y2 <= '0;
      ras_radius <= '0;
      ras_r <= '0;  ras_g <= '0;  ras_b <= '0;
      buffer_sel <= 1'b0;
      perf_latch <= 1'b0;
      perf_clear <= 1'b0;
      cmd_count  <= '0;
      cmd_tick   <= 1'b0;
      seq_last   <= '0;
      err_pend   <= 1'b0;
      vsync_q    <= 1'b0;
    end else begin
      // Pulsos de un solo ciclo: se bajan por defecto y cada estado los
      // levanta cuando corresponde.
      fifo_rd    <= 1'b0;
      ras_start  <= 1'b0;
      perf_latch <= 1'b0;
      perf_clear <= 1'b0;
      cmd_tick   <= 1'b0;
      vsync_q    <= vsync;

      // Un desbordamiento deja pendiente el paso por MOE-06, ocurra en el
      // estado que ocurra, sin tocar el comando en curso.
      if (fifo_drop) err_pend <= 1'b1;

      if (soft_reset) begin
        st       <= Acelerador_pkg::MOE_INIT;
        init_cnt <= '0;
      end else begin
        case (st)

          //------------------------------------------------ MOE-01 Inicio
          Acelerador_pkg::MOE_INIT: begin
            cmd_count  <= '0;
            buffer_sel <= 1'b0;
            seq_last   <= '0;
            err_pend   <= 1'b0;
            if (init_cnt == INIT_CICLOS[2:0]) begin
              init_cnt <= '0;
              st       <= Acelerador_pkg::MOE_IDLE;
            end else begin
              init_cnt <= init_cnt + 3'd1;
            end
          end

          //------------------------------------------------ MOE-02 Espera
          Acelerador_pkg::MOE_IDLE: begin
            if (err_pend) begin
              // Hay un desbordamiento sin senalizar y nada en curso: es el
              // momento de pasar por MOE-06.
              st <= Acelerador_pkg::MOE_ERROR;
            end else if (enable && !fifo_empty) begin
              fifo_rd <= 1'b1;
              st      <= Acelerador_pkg::MOE_PROC;
            end
          end

          //---------------------------------------- MOE-03 Procesamiento
          Acelerador_pkg::MOE_PROC: begin
            // El dato llega un ciclo despues de pedirlo.
            if (fifo_dout_valid) begin
              if (err_cmd) begin
                st <= Acelerador_pkg::MOE_ERROR;
              end else begin
                seq_last <= cmd_in.seq_id;

                case (cmd_in.opcode)
                  Acelerador_pkg::OPC_NOP: begin
                    // Vacia la tuberia y no hace nada mas.
                    cmd_count <= cmd_count + 32'd1;
                    cmd_tick  <= 1'b1;
                    st        <= Acelerador_pkg::MOE_IDLE;
                  end

                  Acelerador_pkg::OPC_SWAP: begin
                    st <= Acelerador_pkg::MOE_SWAP;
                  end

                  Acelerador_pkg::OPC_INF: begin
                    perf_latch <= 1'b1;
                    st         <= Acelerador_pkg::MOE_INFO;
                  end

                  default: begin
                    // Comando de dibujo: se presentan los argumentos y se
                    // lanza el rasterizador en el mismo ciclo.
                    ras_op     <= Acelerador_pkg::opcode_a_op(cmd_in.opcode);
                    ras_x0     <= cmd_in.x0;  ras_y0 <= cmd_in.y0;
                    ras_x1     <= cmd_in.x1;  ras_y1 <= cmd_in.y1;
                    ras_x2     <= cmd_in.x2;  ras_y2 <= cmd_in.y2;
                    ras_radius <= cmd_in.param[9:0];
                    ras_r      <= cmd_in.r;
                    ras_g      <= cmd_in.g;
                    ras_b      <= cmd_in.b;
                    ras_start  <= 1'b1;
                    st         <= Acelerador_pkg::MOE_WAIT;
                  end
                endcase
              end
            end
          end

          //----------------------- MOE-03, subestado: espera al rasterizador
          Acelerador_pkg::MOE_WAIT: begin
            if (ras_done) begin
              cmd_count <= cmd_count + 32'd1;
              cmd_tick  <= 1'b1;
              st        <= Acelerador_pkg::MOE_IDLE;
            end
          end

          //------------------------------------------- MOE-04 Swap Buffer
          // El intercambio se solicita aqui pero solo se hace efectivo en el
          // flanco de sincronizacion vertical: es lo que elimina el desgarro.
          Acelerador_pkg::MOE_SWAP: begin
            if (vsync && !vsync_q) begin
              buffer_sel <= ~buffer_sel;
              cmd_count  <= cmd_count + 32'd1;
              cmd_tick   <= 1'b1;
              st         <= Acelerador_pkg::MOE_IDLE;
            end
          end

          //--------------------------------------------- MOE-05 Informe
          Acelerador_pkg::MOE_INFO: begin
            // Los contadores quedaron congelados por perf_latch al decodificar
            // INF; aqui se reinicia la ventana de medicion y se continua.
            perf_clear <= 1'b1;
            cmd_count  <= cmd_count + 32'd1;
            cmd_tick   <= 1'b1;
            st         <= Acelerador_pkg::MOE_IDLE;
          end

          //----------------------------------------------- MOE-06 Error
          // Un solo ciclo. El error ya quedo contabilizado en el bloque de
          // registro; aqui solo se consume la senalizacion pendiente. Si en
          // este mismo ciclo llega otro desbordamiento, la pendiente se
          // mantiene y se vuelve a pasar por el modo.
          Acelerador_pkg::MOE_ERROR: begin
            if (!fifo_drop) err_pend <= 1'b0;
            st <= Acelerador_pkg::MOE_IDLE;
          end

          default: st <= Acelerador_pkg::MOE_INIT;
        endcase
      end
    end
  end

endmodule
